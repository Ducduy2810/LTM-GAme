# Copy to .env only if .env does not already exist. Keep secrets out of Git.
# Java backend: no NodeMailer or SESSION_SECRET is required.
# Syntax: KEY=value (one '=' separator).

# Origin for email links, OAuth callbacks and secure cookies.
APP_BASE_URL=http://localhost:3000

# Optional Google OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Empty = APP_BASE_URL + /auth/google/callback
GOOGLE_REDIRECT_URI= https://overblown-parsnip-blooming.ngrok-free.dev/auth/google/callback

# SMTP for registration verification and password-reset emails.
# Gmail requires an app password, not the account's sign-in password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# auto: implicit TLS on 465, STARTTLS on 587. Also accepts ssl or starttls.
SMTP_SECURITY=auto

# Optional first-run admin bootstrap; ignored once an admin exists.
# Prefer setup-admin.bat for interactive creation. Password: 12-128 characters.
# Remove bootstrap credentials from .env after creating the account.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
