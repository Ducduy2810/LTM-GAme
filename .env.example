# ================================================================
# SAO CHÉP FILE NÀY THÀNH .env VÀ ĐIỀN GIÁ TRỊ THỰC VÀO
# cp .env.example .env   (Linux/Mac)
# copy .env.example .env (Windows)
# ================================================================

# URL GỐC CỦA SERVER — QUAN TRỌNG
# Người khác lấy source về phải sửa dòng này thành IP máy mình
# Ví dụ LAN:    APP_BASE_URL=http://192.168.1.100:3000
# Ví dụ VPS:    APP_BASE_URL=http://123.456.789.0:3000
# Ví dụ domain: APP_BASE_URL=https://yourdomain.com
APP_BASE_URL=http://localhost:3000

# GOOGLE OAUTH 2.0
# Tạo tại: https://console.cloud.google.com → APIs & Services → Credentials
# Thêm redirect URI: {APP_BASE_URL}/auth/google/callback vào Authorized redirect URIs
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# CẤU HÌNH GỬI MAIL (để trống nếu không dùng tính năng reset mật khẩu)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# BẢO MẬT SESSION
SESSION_SECRET=change_this_to_a_random_secret_string
